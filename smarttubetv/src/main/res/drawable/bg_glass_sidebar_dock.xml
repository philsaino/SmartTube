<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: vertical sidebar dock (frosted slab with right glass edge separator) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Translucent graphite sidebar body -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#59050507"
                android:startColor="#8008080A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Specular highlight on the top edge -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:centerY="0.25"
                android:endColor="#00FFFFFF"
                android:startColor="#1FFFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Hairline glass edge separator on the right -->
    <item
        android:bottom="0dp"
        android:left="-2dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>

</layer-list>
