<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: focused rim. Bright edge, accent hairline and a specular sheen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Specular highlight on the upper half -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_card_corner_radius" />
            <gradient
                android:angle="270"
                android:centerColor="@color/glass_sheen_fade"
                android:centerY="0.45"
                android:endColor="@color/glass_sheen_fade"
                android:startColor="@color/glass_sheen_top"
                android:type="linear" />
        </shape>
    </item>

    <!-- Main rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_card_corner_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/glass_card_rim_focus" />
        </shape>
    </item>

    <!-- Accent refraction, just inside the rim -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_card_image_corner_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_card_rim_accent" />
        </shape>
    </item>

</layer-list>
