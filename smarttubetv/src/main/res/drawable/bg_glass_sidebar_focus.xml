<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: sidebar item focused pill (translucent graphite slab + bright glass rim + specular sheen) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Translucent glass fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:endColor="#14FFFFFF"
                android:startColor="#24FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Specular highlight on top half -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:centerY="0.5"
                android:endColor="#00FFFFFF"
                android:startColor="#38FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Outer rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#E6FFFFFF" />
        </shape>
    </item>

</layer-list>
