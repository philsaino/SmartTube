<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: tooltip frame with satin glass rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tooltip_corner_radius_mod" />
            <gradient
                android:angle="270"
                android:endColor="#F2080B10"
                android:startColor="#F2101622"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tooltip_corner_radius_mod" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
