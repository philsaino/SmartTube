<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Enables the Liquid Glass card rendering (drawables + rim) in presenters -->
    <attr name="glassStyle" format="boolean"/>

    <!--  Color scheme: Liquid Glass  -->
    <style name="TextAppearance.Leanback.ImageCardView.Title.Glass" parent="TextAppearance.Leanback.ImageCardView.Title">
        <item name="android:textColor">@color/glass_text_primary</item>
        <item name="android:textSize">@dimen/glass_card_title_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Leanback.ImageCardView.Content.Glass" parent="TextAppearance.Leanback.ImageCardView.Content">
        <item name="android:textColor">@color/glass_text_secondary</item>
        <item name="android:textSize">@dimen/glass_card_content_text_size</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Widget.Leanback.ImageCardView.TitleStyle.Glass" parent="Widget.Leanback.ImageCardView.TitleStyle">
        <item name="android:textAppearance">@style/TextAppearance.Leanback.ImageCardView.Title.Glass</item>
        <item name="android:textColor">@color/glass_text_primary</item>
        <item name="android:textSize">@dimen/glass_card_title_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:shadowColor">#66000000</item>
        <item name="android:shadowRadius">2</item>
    </style>
    <style name="Widget.Leanback.ImageCardView.ContentStyle.Glass" parent="Widget.Leanback.ImageCardView.ContentStyle">
        <item name="android:textAppearance">@style/TextAppearance.Leanback.ImageCardView.Content.Glass</item>
        <item name="android:textColor">@color/glass_text_secondary</item>
        <item name="android:textSize">@dimen/glass_card_content_text_size</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Widget.Leanback.ImageCardView.InfoAreaStyle.Glass" parent="Widget.Leanback.ImageCardView.InfoAreaStyle">
        <item name="android:background">@drawable/bg_glass_info</item>
        <item name="android:paddingStart">@dimen/glass_card_info_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/glass_card_info_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/glass_card_info_padding_top</item>
        <item name="android:paddingBottom">@dimen/glass_card_info_padding_bottom</item>
    </style>
    <style name="Widget.Leanback.Row.Header.Glass" parent="Widget.Leanback.Row.Header">
        <item name="android:textColor">@color/glass_section_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Leanback.Headers.VerticalGridView.Glass" parent="Widget.Leanback.Headers.VerticalGridView">
        <item name="android:background">@drawable/bg_glass_sidebar_dock</item>
        <item name="android:verticalSpacing">@dimen/browse_headers_vertical_spacing</item>
    </style>
    <style name="App.Theme.Glass.Browse" parent="App.Theme.Leanback.Browse">
        <item name="android:windowBackground">@drawable/bg_glass_backdrop</item>
        <item name="shelfBackground">@drawable/bg_glass_backdrop</item>
        <item name="brandColor">@color/glass_sidebar</item>
        <item name="brandAccentColor">@color/glass_accent</item>
        <item name="cardDefaultBackground">@color/glass_card_default_background</item>
        <item name="cardSelectedBackground">@color/glass_card_selected_background</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Glass</item>
        <item name="imageCardViewInfoAreaStyle">@style/Widget.Leanback.ImageCardView.InfoAreaStyle.Glass</item>
        <item name="imageCardViewTitleStyle">@style/Widget.Leanback.ImageCardView.TitleStyle.Glass</item>
        <item name="imageCardViewContentStyle">@style/Widget.Leanback.ImageCardView.ContentStyle.Glass</item>
        <item name="rowHeaderStyle">@style/Widget.Leanback.Row.Header.Glass</item>
        <item name="headersVerticalGridStyle">@style/Widget.Leanback.Headers.VerticalGridView.Glass</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_accent</item>
        <item name="appLogo">@mipmap/app_logo_semi_red</item>
        <item name="glassStyle">true</item>
    </style>
    <style name="App.Theme.Glass.Player" parent="App.Theme.Leanback.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="shelfBackground">@drawable/bg_glass_backdrop</item>
        <item name="cardDefaultBackground">@color/glass_card_default_background</item>
        <item name="cardSelectedBackground">@color/glass_card_selected_background</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Glass</item>
        <item name="imageCardViewInfoAreaStyle">@style/Widget.Leanback.ImageCardView.InfoAreaStyle.Glass</item>
        <item name="imageCardViewTitleStyle">@style/Widget.Leanback.ImageCardView.TitleStyle.Glass</item>
        <item name="imageCardViewContentStyle">@style/Widget.Leanback.ImageCardView.ContentStyle.Glass</item>
        <item name="playbackProgressPrimaryColor">@color/glass_accent</item>
        <item name="playbackProgressSecondaryColor">@color/white_50</item>
        <item name="playbackControlsIconHighlightColor">@color/glass_accent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_accent</item>
        <item name="glassStyle">true</item>
    </style>
    <style name="App.Theme.Glass.Preferences" parent="App.Theme.Leanback.Preferences">
        <item name="android:colorPrimary" tools:targetApi="21">@color/glass_dialog_background_dark</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_accent</item>
        <item name="glassStyle">true</item>
    </style>
    <style name="ProgressBarHorizontal.Glass" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_glass</item>
    </style>
    <!--  End Color scheme: Liquid Glass  -->
</resources>
