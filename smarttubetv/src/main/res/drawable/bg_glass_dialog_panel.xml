<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: side dialog panel (translucent graphite slab + rounded left edge + glass rim) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Translucent dark graphite fill with soft vertical gradation -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="20dp"
                android:topLeftRadius="20dp"
                android:bottomRightRadius="0dp"
                android:topRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:endColor="#F208080A"
                android:startColor="#F2141416"
                android:type="linear" />
        </shape>
    </item>

    <!-- Specular highlight on top edge -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="20dp"
                android:topLeftRadius="20dp"
                android:bottomRightRadius="0dp"
                android:topRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:centerY="0.15"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Glass rim on the exposed edges (left, top, bottom) -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="-2dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="20dp"
                android:topLeftRadius="20dp"
                android:bottomRightRadius="0dp"
                android:topRightRadius="0dp" />
            <stroke
                android:width="1.5dp"
                android:color="#38FFFFFF" />
        </shape>
    </item>

</layer-list>
