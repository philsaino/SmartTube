<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: glass slab tinted red for items with new content. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@drawable/bg_glass_card" />

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_card_corner_radius" />
            <solid android:color="@color/glass_new_content_wash" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_card_corner_radius" />
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_new_content_rim" />
        </shape>
    </item>

</layer-list>
