<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: state-list selector for sidebar items -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_glass_sidebar_focus" />
    <item android:state_activated="true" android:drawable="@drawable/bg_glass_sidebar_selected" />
    <item android:state_selected="true" android:drawable="@drawable/bg_glass_sidebar_selected" />
    <item android:drawable="@android:color/transparent" />
</selector>
